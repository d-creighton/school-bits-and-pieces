<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <Button
            android:id="@+id/menuButton"
            android:layout_width="match_parent"
            android:layout_height="86dp"
            android:text="Menu" />

        <Button
            android:id="@+id/connectFourButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Connect Four" />

        <Button
            android:id="@+id/checkersButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Checkers" />

        <Button
            android:id="@+id/simonSaysButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Simon Says" />

        <Button
            android:id="@+id/triviaButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Trivia" />

        <Button
            android:id="@+id/memoryButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Memory" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>